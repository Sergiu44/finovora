{
  "compilerOptions": {
    "target": "ESNext",
    "outDir": "dist",
    "sourceMap": true,                                
    "module": "commonjs",                                
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            
    "strict": true,
    "noImplicitAny": true,                                   
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
  },
  "exclude": ["node_modules", "dist"],
  "include": [
    "src/**/*"
  ],
}
