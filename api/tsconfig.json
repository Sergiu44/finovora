{
  "compilerOptions": {
    "target": "es2020",
    "outDir": "dist",
    "sourceMap": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*", "index.d.ts", "models/session.ts", "models/user.ts", "models/verification.ts"],
  "files": ["index.d.ts"]
}
