{
  "compilerOptions": {
    "target": "es2016",
    "outDir": "dist",
    "sourceMap": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "typeRoots": ["index.d.ts"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*", "index.d.ts"]
}
